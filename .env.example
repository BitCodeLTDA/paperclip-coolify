# Required secrets
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret
POSTGRES_PASSWORD=change-me-to-a-strong-db-password

# Optional AI provider keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Deployment mode
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private

# COOLIFY_URL and COOLIFY_DOMAIN are injected automatically by Coolify.
# Do not set them here unless you are testing outside Coolify.
