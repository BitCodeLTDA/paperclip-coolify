# Copy values into Coolify → Resource → Environment.
# Do not use this file as a local Docker Compose --env-file without replacing
# the blank values; Coolify magic values are evaluated by Coolify, not Docker.

# Public deployment
# PAPERCLIP_FQDN is optional: it defaults to Coolify's auto-generated SERVICE_FQDN_PAPERCLIP.
# Only set it if you need to override the generated domain.
# PAPERCLIP_FQDN=paperclip.example.com
# PAPERCLIP_PUBLIC_URL=https://paperclip.example.com
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=public
PAPERCLIP_AUTH_BASE_URL_MODE=explicit

# Required secrets are auto-generated by Coolify from the magic values in docker-compose.yml.
# You only need to add them here if you want to override the generated values.

# Optional provider keys passed through to Paperclip and pi-local agents
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
KIMI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
FIREWORKS_API_KEY=
TOGETHER_API_KEY=
ZAI_API_KEY=
ZAI_CODING_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
AI_GATEWAY_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_RESOURCE_NAME=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT_NAME_MAP=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_GATEWAY_ID=
AWS_ACCESS_KEY_ID=
